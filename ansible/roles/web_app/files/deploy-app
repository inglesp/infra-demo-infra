#!/bin/bash
# Deploy an app's image to Dokku if it differs from what's deployed, and make
# sure TLS is enabled. The image is read from apps.json, which Ansible writes.
# Usage: deploy-app <app>
#
# This is a script rather than a function in deploy, since bash ignores set -e
# in a function that's called as an if condition.
set -euo pipefail

app=$1
image=$(jq -r --arg app "$app" '.[$app] | .image + ":" + .image_tag' /etc/web-app/apps.json)
nginx=$(jq -r --arg app "$app" '.[$app].nginx != false' /etc/web-app/apps.json)

docker pull --quiet "$image" > /dev/null
digest=$(docker image inspect --format '{{index .RepoDigests 0}}' "$image")
deployed=$(dokku git:report "$app" --git-source-image)

if [ "$digest" != "$deployed" ]; then
    # Deploy by digest, so Dokku records exactly which build is running. Each
    # deploy is logged as an event, which can be forwarded to a log server.
    start=$SECONDS
    if dokku git:from-image "$app" "$digest"; then
        result=success
    else
        result=failure
    fi
    logger -t deploy-event \
        "event=deploy app=$app image=$image digest=$digest result=$result duration_s=$((SECONDS - start))"
    # Still fail on failure, so that deploy marks the run as failed
    [ "$result" = success ]
fi

# Let's Encrypt checks the domain by fetching a file from the app over HTTP, so
# this needs the app to have been deployed. An app without nginx has no vhost,
# so no TLS.
if [ "$nginx" = "true" ] && [ "$(dokku letsencrypt:report "$app" --letsencrypt-active)" != "true" ]; then
    dokku letsencrypt:enable "$app"
fi
