#!/bin/bash
# Apply the playbook from the repo if it has changed, then deploy each app with
# deploy-app. The droplet's settings and its apps are read from files that
# cloud-init and Ansible write.
set -euo pipefail

config=/etc/web-app/vars.json
checkout=/var/lib/web-app/repo
failed=0

# Running the playbook here, in the same service as the deploys, means the two
# never compete for Dokku's lock on an app, and a change to an image is
# deployed in the same run. The arguments match the cloud-init bootstrap's.
if ! ansible-pull --only-if-changed \
    --url "$(jq -r .repo_url $config)" \
    --checkout "$(jq -r .repo_branch $config)" \
    --directory $checkout \
    --inventory "$(jq -r .droplet_name $config)," \
    --connection local \
    --extra-vars @$config \
    --vault-password-file /etc/web-app/vault-password \
    ansible/playbook.yml; then
    # The checkout is already at the new commit, so the next run would see no
    # change and skip the playbook. Without a checkout, the next run clones
    # afresh, which counts as a change, and so applies the playbook again.
    echo "Config run failed: removing $checkout so that the next run retries it" >&2
    rm -rf $checkout
    # Carry on, so that a bad config change doesn't block deploys of the apps'
    # code, but fail the run at the end, so that it shows as failed
    failed=1
fi

# Likewise, one app failing to deploy doesn't stop the others
for app in $(jq -r 'keys[]' /etc/web-app/apps.json); do
    if ! deploy-app "$app"; then
        echo "Deploying $app failed" >&2
        failed=1
    fi
done

exit $failed
